#ifndef PASSWORD_H
#define PASSWORD_H

// --- VARSAYILAN WI-FI AYARLARI ---
// Cihaz ilk kez başlatıldığında veya hafızası boşken bu değerler yüklenir.
// Ağ bilgilerinizi buraya girebilir veya cihaz açıldığında Web Panelden (192.168.4.1) ayarlayabilirsiniz.
const char* DEFAULT_WIFI_SSID     = "YOUR_WIFI_SSID";
const char* DEFAULT_WIFI_PASSWORD = "YOUR_WIFI_PASSWORD";
const char* DEFAULT_AP_NAME       = "ESP32-SmartSensor"; // Cihazın yayacağı Hotspot SSID
const int   DEFAULT_WIFI_POWER    = 15;                  // dBm (ESP32-C3 için önerilen: 14 - 17 dBm)

// --- VARSAYILAN BİLDİRİM LEDİ (WS2812) AYARLARI ---
const bool  DEFAULT_LED_ENABLE    = true;
const int   DEFAULT_LED_PIN       = 2;    // ESP32-C3 GPIO 2 (Değiştirilebilir)

// --- VARSAYILAN IOTMER CLOUD MQTT AYARLARI ---
const char* DEFAULT_MQTT_SERVER   = "mqtt.yourbroker.com";  
const int   DEFAULT_MQTT_PORT     = 8883;                     
const char* DEFAULT_MQTT_USER     = "your_mqtt_username";           
const char* DEFAULT_DEVICE_KEY    = "sensor-001";           
const char* DEFAULT_DEVICE_PASS   = "your_mqtt_password";  
const char* DEFAULT_MQTT_TOPIC    = "erhev/sensor-001/state";

// --- VARSAYILAN SUPABASE AYARLARI ---
const bool  DEFAULT_SUPABASE_ENABLE   = true;
const char* DEFAULT_SUPABASE_URL      = "https://your-project.supabase.co/rest/v1/device_telemetry";
const char* DEFAULT_SUPABASE_ANON_KEY = "your-supabase-anon-key";

// --- VARSAYILAN AKILLI TERMOSTAT & RÖLE AYARLARI ---
// Röle Modu: 0 = Devre Dışı, 1 = Manuel (MQTT/Web), 2 = Termostat (Isıtma), 3 = Soğutma (Fan/Klima)
const int   DEFAULT_RELAY_MODE       = 0;     // Varsayılan: Devre Dışı
const int   DEFAULT_RELAY_PIN        = 3;     // ESP32-C3 GPIO 3
const float DEFAULT_TARGET_TEMP      = 24.0;  // Hedef Sıcaklık (°C)
const float DEFAULT_HYSTERESIS       = 0.5;   // Tolerans (°C)

// --- VARSAYILAN ZAMANLAMA VE EŞİK AYARLARI ---
const int   DEFAULT_MQTT_INTERVAL    = 5;     // saniye
const int   DEFAULT_SUPABASE_INTERVAL= 2;     // dakika
const float DEFAULT_TEMP_THRESHOLD   = 0.5;   // °C
const float DEFAULT_HUM_THRESHOLD    = 2.0;   // %

#endif // PASSWORD_H
